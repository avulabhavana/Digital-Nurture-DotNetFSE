// Event Object
class Event{

    constructor(name,date,seats){

        this.name = name;
        this.date = date;
        this.seats = seats;

    }

}

Event.prototype.checkAvailability = function(){

    if(this.seats > 0){
        return "Available";
    }

    return "Full";

};

let obj = new Event("Yoga Camp","28-07-2026",25);

console.log(obj.checkAvailability());

console.log(Object.entries(obj));

