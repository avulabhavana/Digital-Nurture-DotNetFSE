/* Universal Selector */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

/* Body Styles */
body{
    font-family:'Poppins', sans-serif;
    background-color:#f4f4f4;
    color:#333;
    line-height:1.6;
}

/* Header */
#mainHeader{
    background:linear-gradient(to right,#2193b0,#6dd5ed);
    text-align:center;
    color:white;
    padding:20px;
}

.highlight{
    font-size:35px;
    font-weight:bold;
}

/* Navigation */
nav{
    background:#333;
    text-align:center;
    padding:15px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:10px;
    padding:10px;
}

nav a:hover{
    background:#555;
    color:yellow;
}

nav a:visited{
    color:lightgreen;
}

nav a:active{
    color:red;
}

/* Headings */
h2{
    background:linear-gradient(to right,#56ab2f,#a8e063);
    color:white;
    padding:10px;
    margin-top:20px;
}

/* Paragraphs and h3 */
h3,p{
    letter-spacing:1px;
}

/* Section */
section{
    padding:20px;
}

/* Event Card */
.eventCard{
    background:rgba(255,255,255,0.9);
    border:2px solid gray;
    border-radius:10px;
    margin:20px;
    padding:20px;
    box-shadow:2px 2px 6px gray;
}

/* Register Button */
.cta-button{
    background:#007BFF;
    color:white;
    border:none;
    padding:10px 20px;
    border-radius:5px;
    cursor:pointer;
}

.cta-button:hover{
    background:#0056b3;
}

/* Registration Form */
.registrationForm{
    background:white;
    padding:20px;
    border-radius:10px;
}

.registrationForm input,
.registrationForm textarea,
.registrationForm select{
    width:100%;
    padding:10px;
    margin:8px 0;
}

/* Highlight selected field */
.registrationForm input:focus,
.registrationForm textarea:focus,
.registrationForm select:focus{
    outline:2px solid orange;
}

/* Services List */
.services{
    list-style-type:square;
    list-style-position:inside;
}

.services li{
    margin:8px;
    padding:5px;
}

/* Table */
table{
    width:90%;
    margin:auto;
    border-collapse:collapse;
    text-align:center;
}

table,th,td{
    border:1px solid black;
}

th,td{
    padding:10px;
}

tr:nth-child(even){
    background:#f2f2f2;
}

/* Images */
.eventImage{
    width:150px;
    height:150px;
    border-radius:10px;
    transition:0.3s;
}

.eventImage:hover{
    transform:scale(1.1);
}

/* News Section */
.newsArticle{
    column-count:2;
    column-gap:30px;
    column-rule:1px solid gray;
    text-align:justify;
}

/* Text */
p{
    font-size:16px;
    line-height:1.8;
}

h3{
    text-transform:uppercase;
}

/* Visibility Example */
.hiddenBox{
    visibility:hidden;
    background:yellow;
    padding:15px;
    margin:20px;
}

.noneBox{
    display:none;
}

/* Video */
video{
    display:block;
    margin:auto;
    border:2px solid gray;
    border-radius:8px;
}

/* Footer */
footer{
    background:#222;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}

/* Mobile View */
@media screen and (max-width:768px){

    nav{
        display:flex;
        flex-direction:column;
    }

    nav a{
        margin:5px 0;
    }

    .eventImage{
        width:80%;
        height:auto;
    }

    .newsArticle{
        column-count:1;
    }

    h1{
        font-size:28px;
    }

    h2{
        font-size:22px;
    }

    body{
        font-size:14px;
    }

    video{
        width:90%;
    }
}
